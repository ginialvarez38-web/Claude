<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Pax Mundi · el frente, palmo a palmo</title>
<style>
  :root {
    --tinta: #E8DCC0; --apagado: #8A8371; --oro: #D4AF37; --raya: #2A3038;
    --fondo: #0A0F17; --panel: #101822; --rojo: #C94F4F; --cian: #6FB3C9;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: var(--fondo); color: var(--tinta);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; overscroll-behavior: none; }
  #todo { display: flex; height: 100%; flex-direction: row; }
  #lienzo { flex: 1; position: relative; touch-action: none; min-width: 0; }
  canvas { display: block; width: 100%; height: 100%; }
  #lado { width: 320px; flex: none; background: var(--panel); border-left: 1px solid var(--raya);
    padding: 13px; overflow-y: auto; }
  h1 { font-size: 14px; margin: 0 0 3px; font-family: Georgia, serif; color: var(--oro);
    letter-spacing: 0.3px; font-weight: 400; }
  .glosa { font-size: 11px; color: var(--apagado); line-height: 1.5; margin: 0 0 14px; }
  .caja { border: 1px solid var(--raya); border-radius: 8px; padding: 10px; margin-bottom: 11px; }
  .rot { font-size: 9px; letter-spacing: 1.4px; color: var(--oro); margin-bottom: 8px; }
  label { display: block; font-size: 11px; color: var(--apagado); margin: 9px 0 3px; }
  label:first-of-type { margin-top: 0; }
  input[type=range] { width: 100%; accent-color: var(--oro); }
  button { font-family: inherit; font-size: 11.5px; padding: 7px 10px; border-radius: 6px;
    background: transparent; border: 1px solid var(--raya); color: var(--tinta); cursor: pointer; }
  button:hover { border-color: var(--oro); }
  button.on { background: rgba(212,175,55,0.16); border-color: var(--oro); color: var(--oro); }
  .fila { display: flex; gap: 6px; flex-wrap: wrap; }
  .fila button { flex: 1; min-width: 0; }
  table { width: 100%; border-collapse: collapse; font-size: 11px; }
  td { padding: 3px 0; vertical-align: top; }
  td.n { color: var(--apagado); }
  td.v { text-align: right; color: var(--tinta); }
  .barra { height: 5px; background: #1A2230; border-radius: 3px; overflow: hidden; margin-top: 3px;
    display: flex; }
  .barra i { display: block; height: 100%; }
  #reloj { font-size: 20px; font-family: Georgia, serif; color: var(--oro); }
  #pista { position: absolute; left: 12px; bottom: 12px; font-size: 11px; color: var(--apagado);
    background: rgba(10,15,23,0.9); border: 1px solid var(--raya); border-radius: 7px;
    padding: 7px 10px; max-width: 66%; line-height: 1.5; pointer-events: none; }
  .huestes .h { display: flex; align-items: center; gap: 7px; font-size: 11px; padding: 4px 0; }
  .huestes .p { width: 9px; height: 9px; border-radius: 2px; flex: none; }
  @media (max-width: 820px) {
    #todo { flex-direction: column; }
    #lienzo { height: 56%; }
    #lado { width: auto; height: 44%; border-left: none; border-top: 1px solid var(--raya); }
    button { padding: 9px 10px; }
  }
</style>
</head>
<body>
<div id="todo">
  <div id="lienzo"><canvas id="c"></canvas>
    <div id="pista">Tocá el mapa: el ejército elegido marcha hasta ahí y empuja el frente.</div></div>
  <div id="lado">
    <h1>El frente, palmo a palmo</h1>
    <p class="glosa">Los Pirineos de verdad, partidos en palmos de tierra de
      seis kilómetros. Cada palmo tiene dueño y cambia de dueño cuando el de
      enfrente aprieta más, y solo si el que aprieta ya tiene el palmo de al
      lado. Nadie dibuja el frente: los salientes, las bolsas y la línea
      desigual salen de esa sola regla.<br><br>
      Una hueste solo aprieta el trecho que tiene delante; por tierra
      conquistada se abastece peor que por la propia, así que toda ofensiva se
      frena sola; y lo que queda cercado y sin socorro se rinde de hambre.</p>

    <div class="caja">
      <div class="rot">EL TIEMPO</div>
      <div id="reloj">día 0</div>
      <div class="fila" style="margin-top:8px">
        <button id="correr" class="on">▶ correr</button>
        <button id="volver">↺ de nuevo</button>
      </div>
      <label>velocidad · <span id="vVel">6</span> días por segundo</label>
      <input type="range" id="vel" min="1" max="40" value="6">
      <div class="barra" style="margin-top:9px"><i id="bMio"></i><i id="bSuyo"></i></div>
      <table style="margin-top:5px"><tr>
        <td class="n" id="tMio">—</td><td class="v" id="tSuyo">—</td></tr></table>
    </div>

    <div class="caja">
      <div class="rot">LAS HUESTES · TOCÁ UNA Y DESPUÉS EL MAPA</div>
      <div class="huestes" id="huestes"></div>
      <div class="fila" style="margin-top:8px">
        <button id="masMio">+ una mía</button>
        <button id="masSuyo">+ una suya</button>
      </div>
      <label>tamaño de la elegida · <span id="vTropa">60</span> unidades</label>
      <input type="range" id="tropa" min="10" max="240" value="60">
    </div>

    <div class="caja">
      <div class="rot">EL ENEMIGO</div>
      <div class="fila">
        <button id="mDefiende" class="on">contraataca</button>
        <button id="mQuieto">se queda quieto</button>
      </div>
      <p class="glosa" style="margin:8px 0 0">Si contraataca, sus huestes van a donde
        más terreno perdieron y lo recuperan. Ahí es donde aparecen las bolsas.</p>
    </div>

    <div class="caja">
      <div class="rot">EL TERRENO</div>
      <label>el palmo mide · <span id="vPalmo">6</span> km</label>
      <input type="range" id="palmo" min="3" max="16" value="6">
      <label>lo irregular del frente · <span id="vRuido">50</span>%</label>
      <input type="range" id="ruido" min="0" max="100" value="50">
      <div class="fila" style="margin-top:9px">
        <button id="mSigue" class="on">seguir a la elegida</button>
        <button id="mTodo">ver todo</button>
      </div>
      <label>de cerca · <span id="vLupa">5.0</span>° de ancho</label>
      <input type="range" id="lupa" min="15" max="130" value="50">
    </div>

    <div class="caja">
      <div class="rot">COMARCAS</div>
      <div id="comarcas" style="font-size:11px;color:var(--apagado)">—</div>
    </div>
  </div>
</div>
<script>
"use strict";
const COMARCAS = /*DATOS*/[]/*FIN*/;

// ═══ las reglas ═════════════════════════════════════════════════
// Copiadas a mano del juego y no importadas: este archivo tiene que abrirse
// solo, sin nada al lado.
const GRADO_KM = 111.32;
const TERRENOS = {
  llanura: { n: "llanura", def: 0.90, com: 1.00, col: "#6E9B4E" },
  colina:  { n: "colina",  def: 1.15, com: 0.88, col: "#7E8F52" },
  montana: { n: "montaña", def: 1.55, com: 0.70, col: "#7C7A82" },
  meseta:  { n: "meseta",  def: 1.05, com: 0.92, col: "#93885E" },
  bosque:  { n: "bosque",  def: 1.25, com: 0.80, col: "#4E7444" },
  vega:    { n: "vega",    def: 0.85, com: 1.05, col: "#6FA05C" },
  delta:   { n: "delta",   def: 0.80, com: 1.10, col: "#5E9A72" },
  estepa:  { n: "estepa",  def: 0.95, com: 0.95, col: "#A29A63" },
  desierto:{ n: "desierto",def: 1.10, com: 0.72, col: "#B9A66F" },
  tundra:  { n: "tundra",  def: 1.20, com: 0.62, col: "#8FA0A6" },
  costa:   { n: "costa",   def: 0.90, com: 1.08, col: "#5F9A8E" },
};
const CLAVES_TER = Object.keys(TERRENOS);
const ter = (t) => TERRENOS[t] || TERRENOS.llanura;
const acotar = (v, a, b) => Math.max(a, Math.min(b, v));
function leguas(a, b) {
  const dy = (a.y - b.y) * GRADO_KM;
  const dx = (a.x - b.x) * GRADO_KM * Math.cos(((90 - (a.y + b.y) / 2) * Math.PI) / 180);
  return Math.hypot(dx, dy);
}
const velocidadHueste = (t) => 22 * ter(t).com;

const MIO = 1, SUYO = 0;                       // los dos bandos
const COL = { 1: [212, 175, 55], 0: [150, 92, 92] };
for (const c of COMARCAS) c.ruta = new Path2D(c.d);

// ═══ la rejilla ══════════════════════════════════════════════════
//
// El mapa entero partido en palmos de tierra. Cada palmo sabe qué comarca es,
// qué terreno tiene y de quién es hoy. No hay «avance de la comarca» por
// ningún lado: hay palmos que cambian de dueño, y la comarca es de quien tenga
// la mayoría. De ahí salen solos los salientes y las bolsas, que es lo que
// pasa en una guerra y lo que no puede salir nunca de un disco que crece.
let GW = 0, GH = 0, gx0 = 0, gy0 = 0, paso = 0;   // paso = lado del palmo en grados
let cProv, cTer, cDue, cPres, cAzar, cPie, cNat, cHambre, cAisla;
let campoMio, campoSuyo, tmp;
const fuera = new Uint8Array(0);

function extension() {
  let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;
  for (const c of COMARCAS) { x0 = Math.min(x0, c.x0); y0 = Math.min(y0, c.y0);
    x1 = Math.max(x1, c.x1); y1 = Math.max(y1, c.y1); }
  return { x0, y0, x1, y1 };
}

// Qué comarca cae en cada palmo. Preguntarlo polígono por polígono serían
// treinta mil palmos por setenta y dos contornos; se pinta cada comarca de un
// color que es su número y se leen los píxeles de una vez.
function rasterizar() {
  const e = extension();
  const km = cfg.palmo;
  paso = km / GRADO_KM;
  gx0 = e.x0 - paso; gy0 = e.y0 - paso;
  GW = Math.ceil((e.x1 - e.x0) / paso) + 2;
  GH = Math.ceil((e.y1 - e.y0) / paso) + 2;
  const n = GW * GH;
  cProv = new Int16Array(n); cTer = new Uint8Array(n); cDue = new Int8Array(n);
  cPres = new Float32Array(n); cAzar = new Float32Array(n); cPie = new Int8Array(n);
  cNat = new Int8Array(n); cHambre = new Float32Array(n); cAisla = new Uint8Array(n);
  campoMio = new Float32Array(n); campoSuyo = new Float32Array(n); tmp = new Float32Array(n);
  cProv.fill(-1); cDue.fill(-1);
  // Una comarca por vez, en blanco sobre nada. Meter el número de la comarca
  // dentro del color y leerlos todos de una sola pasada parecía más listo y
  // estaba mal: el canvas suaviza los bordes, y un píxel del borde salía con
  // el color mezclado de dos comarcas, o sea con el número de una tercera.
  const off = document.createElement("canvas");
  off.width = GW; off.height = GH;
  const g = off.getContext("2d", { willReadFrequently: true });
  g.lineJoin = "round";
  COMARCAS.forEach((c, k) => {
    g.setTransform(1, 0, 0, 1, 0, 0);
    g.clearRect(0, 0, GW, GH);
    g.setTransform(1 / paso, 0, 0, 1 / paso, -gx0 / paso, -gy0 / paso);
    g.fillStyle = "#fff"; g.strokeStyle = "#fff"; g.lineWidth = paso * 0.9;
    g.fill(c.ruta); g.stroke(c.ruta);          // el trazo cierra las rendijas
    const d = g.getImageData(0, 0, GW, GH).data;
    const t = Math.max(0, CLAVES_TER.indexOf(c.t));
    const due = c.p === "Spain" ? MIO : SUYO;
    for (let i = 0; i < n; i++) {
      if (d[i * 4 + 3] < 110) continue;
      cProv[i] = k; cTer[i] = t; cDue[i] = due; cNat[i] = due;
    }
  });
  for (let i = 0; i < n; i++) {
    if (cProv[i] < 0) continue;
    // Un número fijo por palmo: sin esto el frente sería un compás. Con esto,
    // unos palmos se resisten más que otros y la línea sale desigual sola.
    let h = (i * 2654435761) ^ 0x9e3779b9;
    h = (h ^ (h >>> 15)) * 2246822519; h = (h ^ (h >>> 13)) * 3266489917;
    cAzar[i] = ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  }
  imgFrente = new ImageData(GW, GH);
  lienzoFrente = document.createElement("canvas");
  lienzoFrente.width = GW; lienzoFrente.height = GH;
}
const celdaDe = (x, y) => {
  const i = Math.floor((x - gx0) / paso), j = Math.floor((y - gy0) / paso);
  if (i < 0 || j < 0 || i >= GW || j >= GH) return -1;
  return j * GW + i;
};
const xDe = (k) => gx0 + ((k % GW) + 0.5) * paso;
const yDe = (k) => gy0 + (Math.floor(k / GW) + 0.5) * paso;

// Dónde tiene los pies puesto cada hueste. Una hueste no es un punto: ocupa
// unas leguas a la redonda, y ese suelo lo está pisando de verdad, sea de
// quien sea. Sin esto, una hueste metida en tierra ajena quedaba rodeada de
// palmos del otro y la regla de «solo se toma lo que se toca» la dejaba
// paralizada: no podía empezar por ningún lado.
const RADIO_PIE_KM = 13;
// Cuánto frente puede apretar una hueste. Una hueste no empuja toda la línea a
// la vez: aprieta el trecho que tiene delante y el resto se queda mirando. Sin
// esto, un solo ejército avanzaba en una ola pareja por todo el mapa, y dos
// ejércitos que iban a hacer una tenaza no dejaban hueco en el medio —el
// hueco es justamente lo que hace la bolsa—.
const ALCANCE_KM = 55;
function marcarPies() {
  cPie.fill(-1);
  const r = Math.max(1, Math.round(RADIO_PIE_KM / (paso * GRADO_KM)));
  for (const h of huestes) {
    const ci = Math.floor((h.x - gx0) / paso), cj = Math.floor((h.y - gy0) / paso);
    for (let dj = -r; dj <= r; dj++) for (let di = -r; di <= r; di++) {
      if (di * di + dj * dj > r * r) continue;
      const i = ci + di, j = cj + dj;
      if (i < 0 || j < 0 || i >= GW || j >= GH) continue;
      const k = j * GW + i;
      if (cProv[k] >= 0) cPie[k] = h.bando;
    }
  }
}

// A qué distancia tiene cada palmo la hueste más cercana de cada bando. De ahí
// sale cuánto de su empuje llega hasta ahí: mucho justo delante, poco a cien
// kilómetros. Es lo que hace que el avance sea una punta de lanza y no una ola.
let alcMio = null, alcSuyo = null;
function medirAlcance() {
  const n = GW * GH;
  if (!alcMio || alcMio.length !== n) { alcMio = new Float32Array(n); alcSuyo = new Float32Array(n); }
  alcMio.fill(1e9); alcSuyo.fill(1e9);
  const gkm = paso * GRADO_KM;
  for (const h of huestes) {
    const a = h.bando === MIO ? alcMio : alcSuyo;
    const ci = (h.x - gx0) / paso, cj = (h.y - gy0) / paso;
    // solo hace falta mirar alrededor: más allá del alcance ya da lo mismo
    const r = Math.ceil((ALCANCE_KM * 3) / gkm);
    const i0 = Math.max(0, Math.floor(ci - r)), i1 = Math.min(GW - 1, Math.ceil(ci + r));
    const j0 = Math.max(0, Math.floor(cj - r)), j1 = Math.min(GH - 1, Math.ceil(cj + r));
    for (let j = j0; j <= j1; j++) for (let i = i0; i <= i1; i++) {
      const d = Math.hypot(i - ci, j - cj) * gkm;
      const k = j * GW + i;
      if (d < a[k]) a[k] = d;
    }
  }
}

// ═══ el campo de cada bando ══════════════════════════════════════
//
// Cuánta fuerza alcanza a proyectar cada bando sobre cada palmo. Nace en las
// huestes y en las plazas, y se propaga de palmo en palmo perdiendo por el
// camino: mucho menos si tiene que atravesar tierra del otro, y menos también
// por la montaña. De ahí sale todo lo demás.
//
// Una bolsa cercada se queda sin campo porque su gente ya no llega hasta ella:
// no hay ninguna regla que diga «si está rodeada, cae». Cae porque se le corta
// lo que la sostenía, que es como cae de verdad.
function propagar(campo, bando) {
  const n = GW * GH;
  campo.fill(0);
  // las huestes, sobre todo el suelo que pisan
  for (const h of huestes) if (h.bando === bando) {
    const r = Math.max(1, Math.round(RADIO_PIE_KM / (paso * GRADO_KM)));
    const ci = Math.floor((h.x - gx0) / paso), cj = Math.floor((h.y - gy0) / paso);
    for (let dj = -r; dj <= r; dj++) for (let di = -r; di <= r; di++) {
      if (di * di + dj * dj > r * r) continue;
      const i = ci + di, j = cj + dj;
      if (i < 0 || j < 0 || i >= GW || j >= GH) continue;
      const k = j * GW + i;
      if (cProv[k] >= 0 && h.n > campo[k]) campo[k] = h.n;
    }
  }
  // y las plazas: cada comarca sostiene lo suyo, poco pero desde dentro
  // Y las plazas: cada comarca sostiene a los suyos desde dentro. A quien la
  // ocupa no le sostiene nada —esa gente no es suya—, y por eso una comarca
  // tomada no se defiende sola: hay que dejarle tropa encima o se pierde.
  for (const c of COMARCAS) {
    const k = celdaDe(c.x, c.y);
    if (k < 0 || cNat[k] !== bando) continue;
    const suya = cDue[k] === bando;
    campo[k] = Math.max(campo[k], c.guarnicion * (suya ? 1 : 0.35));
  }
  // dos barridos, ida y vuelta: alcanza para que la fuerza llegue a todos
  // lados por el camino más barato, y cuesta cuatro pasadas por palmo.
  // Lo que se pierde al pasar de un palmo al siguiente. Por tierra propia se
  // pierde poco —hay caminos, hay quien avise, hay dónde dormir—; por tierra
  // del otro se pierde mucho, y de ahí sale que para proyectar fuerza lejos
  // primero haya que ir tomando el suelo. La montaña encarece las dos cosas.
  //
  // Tiene que ser menor que uno, siempre: con 1,005 —que es lo que daba la
  // primera cuenta— la fuerza no se propaga, se multiplica, y los dos campos
  // crecían sin freno hasta que la razón entre ellos daba medio a medio en
  // todas partes. El frente quedaba clavado y no se entendía por qué.
  //
  // Y hay tres clases de suelo, no dos: la casa de uno, lo que uno le tomó al
  // otro, y lo del otro. Por lo conquistado se pasa peor que por casa —la
  // gente no es tuya, los caminos los cortan, hay que dejar guarnición en cada
  // pueblo—, y de ahí sale sola la culminación: toda ofensiva se frena cuando
  // se aleja demasiado de su tierra, y es entonces cuando el otro contraataca.
  const paso1 = (i) => {
    const t = TERRENOS[CLAVES_TER[cTer[i]]] || TERRENOS.llanura;
    const base = cDue[i] !== bando ? 0.862 : cNat[i] === bando ? 0.978 : 0.935;
    return base * (1 - (t.def - 1) * 0.10);
  };
  for (let vuelta = 0; vuelta < 2; vuelta++) {
    for (let j = 1; j < GH; j++) for (let i = 1; i < GW; i++) {
      const k = j * GW + i;
      if (cProv[k] < 0) continue;
      const d = paso1(k);
      let v = campo[k];
      if (campo[k - 1] * d > v) v = campo[k - 1] * d;
      if (campo[k - GW] * d > v) v = campo[k - GW] * d;
      if (campo[k - GW - 1] * d * 0.96 > v) v = campo[k - GW - 1] * d * 0.96;
      campo[k] = v;
    }
    for (let j = GH - 2; j >= 0; j--) for (let i = GW - 2; i >= 0; i--) {
      const k = j * GW + i;
      if (cProv[k] < 0) continue;
      const d = paso1(k);
      let v = campo[k];
      if (campo[k + 1] * d > v) v = campo[k + 1] * d;
      if (campo[k + GW] * d > v) v = campo[k + GW] * d;
      if (campo[k + GW + 1] * d * 0.96 > v) v = campo[k + GW + 1] * d * 0.96;
      campo[k] = v;
    }
  }
}

// ═══ el hambre de los cercados ═══════════════════════════════════
//
// Un trozo de ejército que queda rodeado y sin nadie que lo socorra no aguanta
// por muy buena que sea su montaña: se le acaba el pan, la pólvora y las
// ganas. Sin esto, una bolsa cerrada se quedaba ahí para siempre y había que
// ir a tomarla palmo por palmo, que no es lo que pasa cuando cae un cerco.
//
// Se mira quién está cercado de verdad: trozos sueltos del cuerpo del país,
// rodeados de enemigo y no de mar, y sin ninguna hueste propia adentro que
// pueda romper el cerco. Es caro de calcular, así que se hace cada tantos días
// —una bolsa no se cierra ni se abre de un día para el otro—.
const DIAS_DE_HAMBRE = 65;
let marcaA = null, pilaA = null;
function marcarAislados() {
  const n = GW * GH;
  if (!marcaA || marcaA.length !== n) { marcaA = new Uint8Array(n); pilaA = new Int32Array(n); }
  cAisla.fill(0);
  for (const bando of [MIO, SUYO]) {
    marcaA.fill(0);
    const otro = 1 - bando;
    const trozos = [];
    for (let s0 = 0; s0 < n; s0++) {
      if (marcaA[s0] || cProv[s0] < 0 || cDue[s0] !== bando) continue;
      let tope = 0; const cel = [];
      let ene = 0, nada = 0;
      pilaA[tope++] = s0; marcaA[s0] = 1;
      while (tope) {
        const k = pilaA[--tope]; cel.push(k);
        const j = k % GW;
        const ver = (q) => {
          if (q < 0 || q >= n || cProv[q] < 0) { nada++; return; }
          if (cDue[q] === otro) { ene++; return; }
          if (!marcaA[q]) { marcaA[q] = 1; pilaA[tope++] = q; }
        };
        ver(j > 0 ? k - 1 : -1); ver(j < GW - 1 ? k + 1 : -1);
        ver(k - GW); ver(k + GW);
      }
      trozos.push({ cel, cercada: ene > (ene + nada) * 0.6 });
    }
    trozos.sort((a, b) => b.cel.length - a.cel.length);
    for (const t of trozos.slice(1)) {
      if (!t.cercada) continue;
      // ¿hay alguna hueste suya adentro? entonces no está perdida
      const dentro = huestes.some((h) => {
        if (h.bando !== bando) return false;
        const k = celdaDe(h.x, h.y);
        return k >= 0 && t.cel.includes(k);
      });
      if (dentro) continue;
      for (const k of t.cel) cAisla[k] = 1;
    }
  }
}

// ═══ el día ══════════════════════════════════════════════════════
let dia = 0, corriendo = true;
let huestes = [], elegida = 0;
let contra = true;
const cfg = { vel: 6, palmo: 6, ruido: 50, tropa: 60, lupa: 50 };

function nuevaHueste(bando, x, y, n) {
  return { bando, x, y, n: n || 60, dest: null,
    nombre: (bando === MIO ? "hueste " : "hueste enemiga ")
      + (huestes.filter((h) => h.bando === bando).length + 1) };
}

function reiniciar() {
  for (const c of COMARCAS) {
    c.guarnicion = 5 + Math.pow(c.pob, 0.42) * 1.9;
  }
  rasterizar();
  const mia = COMARCAS.find((c) => c.n === "Navarra") || COMARCAS.find((c) => c.p === "Spain");
  const suya = COMARCAS.filter((c) => c.p === "France")
    .map((c) => ({ c, d: leguas(mia, c) })).sort((a, b) => a.d - b.d)[3];
  huestes = [nuevaHueste(MIO, mia.x, mia.y, 60), nuevaHueste(SUYO, suya.c.x, suya.c.y, 45)];
  elegida = 0; dia = 0;
  mira = { x: mia.x, y: mia.y };
  encuadrar();
}

// Adónde va cada hueste enemiga: a donde más se perdió. Sin esto el frente es
// una ola que nunca vuelve, y lo que se quería ver era justamente que vuelva.
function pensarEnemigo() {
  const perdidas = COMARCAS.map((c, k) => ({ c, k, p: 0, n: 0 }));
  for (let i = 0; i < cProv.length; i++) {
    const p = cProv[i]; if (p < 0) continue;
    perdidas[p].n++;
    if (cDue[i] === MIO && COMARCAS[p].p === "France") perdidas[p].p++;
  }
  const rotas = perdidas.filter((o) => o.p > 3).sort((a, b) => b.p - a.p);
  for (const h of huestes) {
    if (h.bando !== SUYO) continue;
    if (!rotas.length) { h.dest = null; continue; }
    // cada hueste al desgarrón más cercano que no tenga ya a otra encima
    let mejor = null, mp = -1;
    for (const o of rotas) {
      const d = leguas(h, o.c);
      const otra = huestes.some((q) => q !== h && q.bando === SUYO && q.dest
        && leguas(q.dest, o.c) < 60);
      const puntos = o.p / (1 + d / 120) * (otra ? 0.25 : 1);
      if (puntos > mp) { mp = puntos; mejor = o.c; }
    }
    if (mejor) h.dest = { x: mejor.x, y: mejor.y };
  }
}

function unDia() {
  dia++;
  // marchar
  for (const h of huestes) {
    if (!h.dest) continue;
    const k = celdaDe(h.x, h.y);
    const v = velocidadHueste(k >= 0 && cProv[k] >= 0 ? CLAVES_TER[cTer[k]] : "llanura");
    const falta = leguas(h, h.dest);
    if (v >= falta) { h.x = h.dest.x; h.y = h.dest.y; h.dest = null; }
    else { const f = v / falta; h.x += (h.dest.x - h.x) * f; h.y += (h.dest.y - h.y) * f; }
  }
  if (contra && dia % 10 === 0) pensarEnemigo();

  marcarPies();
  medirAlcance();
  if (dia % 8 === 0) marcarAislados();
  propagar(campoMio, MIO);
  propagar(campoSuyo, SUYO);

  // Y ahora el empujón, palmo por palmo. Un palmo solo cambia de dueño si toca
  // tierra del que empuja: así el frente avanza desde donde se entró y no
  // brota en el medio, que era lo que hacía el disco. De esa sola regla salen
  // los salientes —por donde se aprieta, se mete una lengua— y las bolsas
  // —cuando dos lenguas se juntan por detrás—.
  const desorden = cfg.ruido / 100;
  const n = GW * GH;
  for (let i = 0; i < n; i++) {
    if (cProv[i] < 0) continue;
    // el hambre de los cercados, que sube sola y baja despacio si los sueltan
    if (cAisla[i]) cHambre[i] = Math.min(1, cHambre[i] + 1 / DIAS_DE_HAMBRE);
    else if (cHambre[i] > 0) cHambre[i] = Math.max(0, cHambre[i] - 1 / (DIAS_DE_HAMBRE * 2.5));
    const mio = cDue[i] === MIO;
    const ata = mio ? campoSuyo[i] : campoMio[i];
    // al cercado se le acaba todo: al final se rinde aunque nadie lo asalte
    const def = (mio ? campoMio[i] : campoSuyo[i]) * (1 - 0.92 * cHambre[i]);
    if (ata <= 0) { cPres[i] *= 0.94; continue; }
    // ¿el que empuja toca este palmo?
    const bandoAtaca = mio ? SUYO : MIO;
    const j = i % GW;
    let pegado = false;
    if (j > 0 && cDue[i - 1] === bandoAtaca) pegado = true;
    else if (j < GW - 1 && cDue[i + 1] === bandoAtaca) pegado = true;
    else if (i >= GW && cDue[i - GW] === bandoAtaca) pegado = true;
    else if (i + GW < n && cDue[i + GW] === bandoAtaca) pegado = true;
    // …o lo tiene bajo los pies, que es tocarlo de la manera más directa
    if (!pegado && cPie[i] !== bandoAtaca) { cPres[i] *= 0.94; continue; }
    // Un cercado sin pan se rinde solo, aunque no tenga a nadie encima. Los
    // cercos no se ganan a bayoneta: se ganan esperando.
    if (cHambre[i] >= 1) { cDue[i] = bandoAtaca; cPres[i] = 0; cHambre[i] = 0; continue; }
    const t = TERRENOS[CLAVES_TER[cTer[i]]] || TERRENOS.llanura;
    // Lo que cuesta este palmo: el terreno, y su propia terquedad.
    //
    // La dureza divide el ritmo, no suma a la defensa. Parece lo mismo y no lo
    // es: sumando, un palmo de montaña con mala suerte quedaba con la defensa
    // por encima del ataque para siempre, y ahí se plantaba —había bolsas
    // cercadas de un solo palmo que aguantaban quinientos días en medio de
    // territorio ajeno—. Dividiendo, la montaña tarda el doble en caer, que es
    // lo que hace la montaña; lo que no hace es volver inmortal a nadie.
    const dureza = t.def * (1 - desorden * 0.55 + desorden * 1.1 * cAzar[i]);
    const razon = ata / (ata + def * 1.35);
    // y cuánto de ese empuje llega de verdad hasta acá
    const d = (bandoAtaca === MIO ? alcMio : alcSuyo)[i];
    const alcance = 1 / (1 + (d / ALCANCE_KM) * (d / ALCANCE_KM));
    const empuje = ((razon - 0.5) * 3.6 * alcance) / dureza;
    cPres[i] += empuje;
    if (cPres[i] >= 1) { cDue[i] = bandoAtaca; cPres[i] = 0; }
    else if (cPres[i] < 0) cPres[i] = 0;
  }
}

// ═══ el dibujo ═══════════════════════════════════════════════════
const cv = document.getElementById("c");
const cx = cv.getContext("2d");
let W = 0, H = 0, esc = 1, ox = 0, oy = 0, dpr = 1;
let mira = { x: 0, y: 0 }, siguiendo = true;
let imgFrente = null, lienzoFrente = null;

function encuadrar() {
  const caja = cv.parentElement.getBoundingClientRect();
  dpr = Math.min(2, window.devicePixelRatio || 1);
  W = Math.round(caja.width); H = Math.round(caja.height);
  cv.width = W * dpr; cv.height = H * dpr;
  cx.setTransform(dpr, 0, 0, dpr, 0, 0);
  if (siguiendo) {
    esc = W / (cfg.lupa / 10);
    ox = W / 2 - mira.x * esc;
    oy = H / 2 - mira.y * esc;
  } else {
    const { x0, y0, x1, y1 } = extension();
    const m = 0.25;
    esc = Math.min(W / (x1 - x0 + m * 2), H / (y1 - y0 + m * 2));
    ox = (W - (x1 - x0) * esc) / 2 - x0 * esc;
    oy = (H - (y1 - y0) * esc) / 2 - y0 * esc;
  }
}
const aPx = (x, y) => [x * esc + ox, y * esc + oy];
const aMundo = (px, py) => [(px - ox) / esc, (py - oy) / esc];

// El frente se pinta escribiendo los palmos uno a uno en una imagen del tamaño
// de la rejilla y estirándola después sin suavizar. Es literalmente un píxel
// por palmo de tierra: por eso los bordes salen dentados y no redondeados.
// La retaguardia va apenas teñida —el terreno tiene que seguir viéndose, es un
// mapa, no un tablero de damas— y lo que grita es la línea del frente: los
// palmos que tocan al otro bando, y los que están cambiando de manos ahora
// mismo. Teñir todo por igual dejaba el mapa entero de un barro parejo donde
// no se distinguía nada, que es lo que pasaba antes.
function pintarFrente() {
  const d = imgFrente.data;
  const n = GW * GH;
  for (let i = 0; i < n; i++) {
    const o = i * 4;
    const due = cDue[i];
    if (cProv[i] < 0 || due < 0) { d[o + 3] = 0; continue; }
    const c = COL[due];
    // ¿toca al otro bando? entonces es filo del frente
    const j = i % GW;
    const otro = 1 - due;
    const filo = (j > 0 && cDue[i - 1] === otro) || (j < GW - 1 && cDue[i + 1] === otro)
      || (i >= GW && cDue[i - GW] === otro) || (i + GW < n && cDue[i + GW] === otro);
    const disputa = cPres[i] > 0.05;
    let r = c[0], v = c[1], a = c[2], op;
    if (disputa) {
      // el palmo que está cambiando de manos: casi blanco, y cuanto más cerca
      // de caer, más claro
      const k = acotar(cPres[i], 0, 1);
      r = Math.min(255, c[0] + 70 * k + 25); v = Math.min(255, c[1] + 75 * k + 25);
      a = Math.min(255, c[2] + 90 * k + 25);
      op = 215;
    } else if (filo) { op = 225; }
    else { op = due === MIO ? 72 : 58; }
    // Lo cercado y sin socorro se apaga hacia el gris según se le acaba el
    // pan: se ve de lejos qué bolsa está viva y cuál ya está para caer.
    const ham = cHambre[i];
    if (ham > 0.02) {
      const g = (r + v + a) / 3;
      r += (g - r) * ham * 0.85; v += (g - v) * ham * 0.85; a += (g - a) * ham * 0.85;
      op = Math.max(op, 110 + 90 * ham);
    }
    d[o] = r; d[o + 1] = v; d[o + 2] = a; d[o + 3] = op;
  }
  lienzoFrente.getContext("2d").putImageData(imgFrente, 0, 0);
}

function dibujar() {
  cx.clearRect(0, 0, W, H);
  cx.save();
  cx.translate(ox, oy); cx.scale(esc, esc);
  const fino = 1 / esc;

  // el suelo, engordado: los contornos vienen simplificados y de cerca dejan
  // rendijas negras entre comarca y comarca
  cx.lineJoin = "round"; cx.lineCap = "round";
  cx.fillStyle = "#3F4A3C"; cx.strokeStyle = "#3F4A3C"; cx.lineWidth = 3 * fino;
  for (const c of COMARCAS) { cx.fill(c.ruta); cx.stroke(c.ruta); }
  for (const c of COMARCAS) {
    const col = ter(c.t).col;
    cx.fillStyle = col; cx.strokeStyle = col; cx.lineWidth = 1.4 * fino;
    cx.globalAlpha = 0.85; cx.fill(c.ruta); cx.stroke(c.ruta);
  }
  cx.globalAlpha = 1;
  cx.restore();

  // el frente encima, palmo por palmo y sin suavizar
  pintarFrente();
  cx.imageSmoothingEnabled = false;
  cx.drawImage(lienzoFrente, gx0 * esc + ox, gy0 * esc + oy, GW * paso * esc, GH * paso * esc);
  cx.imageSmoothingEnabled = true;

  cx.save();
  cx.translate(ox, oy); cx.scale(esc, esc);
  const fino2 = 1 / esc;
  for (const c of COMARCAS) {
    cx.lineWidth = fino2 * 0.8; cx.strokeStyle = "rgba(10,14,20,0.5)"; cx.stroke(c.ruta);
  }
  for (const h of huestes) if (h.dest) {
    cx.beginPath(); cx.moveTo(h.x, h.y); cx.lineTo(h.dest.x, h.dest.y);
    cx.setLineDash([fino2 * 5, fino2 * 5]); cx.lineWidth = fino2 * 1.4;
    cx.strokeStyle = h.bando === MIO ? "#6FB3C9" : "#C97F7F";
    cx.stroke(); cx.setLineDash([]);
  }
  cx.restore();

  // las huestes
  huestes.forEach((h, k) => {
    const [px, py] = aPx(h.x, h.y);
    const col = h.bando === MIO ? "#D4AF37" : "#C94F4F";
    cx.beginPath(); cx.arc(px, py, 14, 0, 7);
    cx.fillStyle = "rgba(10,14,20,0.92)"; cx.fill();
    cx.lineWidth = k === elegida ? 3.2 : 1.8; cx.strokeStyle = col; cx.stroke();
    cx.fillStyle = col; cx.font = "600 11px ui-monospace, monospace";
    cx.textAlign = "center"; cx.textBaseline = "middle";
    cx.fillText(String(Math.round(h.n)), px, py + 0.5);
  });

  // los nombres de las comarcas partidas
  cx.font = "12px Georgia, serif"; cx.textBaseline = "alphabetic";
  for (const c of COMARCAS) {
    if (!c.partida) continue;
    const [px, py] = aPx(c.x, c.y);
    if (px < -60 || px > W + 60 || py < 0 || py > H) continue;
    cx.lineWidth = 3; cx.strokeStyle = "rgba(6,10,16,0.85)";
    cx.strokeText(c.n, px, py - 16); cx.fillStyle = "#E8DCC0";
    cx.fillText(c.n, px, py - 16);
  }
}

// ═══ el panel ════════════════════════════════════════════════════
let cuenta = { mio: 0, suyo: 0, mias: 0, suyas: 0, partidas: 0, bolsasM: [], bolsasS: [] };
let marca = null, pila = null;

// Las bolsas: trozos de un bando que quedaron sueltos, sin camino por tierra
// propia hasta el grueso de los suyos. No hay ninguna regla que las cree —no
// existe un «rodear»—: aparecen cuando dos avances se juntan por detrás, que
// es como aparecen de verdad. Se cuentan buscando los trozos conexos y
// dejando fuera el mayor, que es el cuerpo del ejército.
function bolsasDe(bando) {
  const n = GW * GH;
  if (!marca || marca.length !== n) { marca = new Uint8Array(n); pila = new Int32Array(n); }
  marca.fill(0);
  const trozos = [];
  const otro = 1 - bando;
  for (let s0 = 0; s0 < n; s0++) {
    if (marca[s0] || cProv[s0] < 0 || cDue[s0] !== bando) continue;
    let tope = 0, tam = 0, conEnemigo = 0, conNada = 0;
    pila[tope++] = s0; marca[s0] = 1;
    while (tope) {
      const k = pila[--tope]; tam++;
      const j = k % GW;
      const ver = (q) => {
        if (q < 0 || q >= n) { conNada++; return; }
        if (cProv[q] < 0) { conNada++; return; }          // mar, o fuera del mapa
        if (cDue[q] === otro) { conEnemigo++; return; }
        if (!marca[q]) { marca[q] = 1; pila[tope++] = q; }
      };
      ver(j > 0 ? k - 1 : -1);
      ver(j < GW - 1 ? k + 1 : -1);
      ver(k - GW);
      ver(k + GW);
    }
    // Una isla no es una bolsa. Las dos están sueltas del cuerpo del país, pero
    // a una la separa el mar y a la otra la separó el enemigo, y solo la
    // segunda está cercada. Se distinguen mirando qué tiene alrededor.
    const cercada = conEnemigo > (conEnemigo + conNada) * 0.6;
    trozos.push({ tam, cercada });
  }
  trozos.sort((a, b) => b.tam - a.tam);
  // el mayor es el cuerpo del país; de lo demás, solo lo que está cercado, y
  // no los dos o tres palmos que deja el vaivén del borde
  return trozos.slice(1).filter((t) => t.cercada && t.tam >= 4).map((t) => t.tam);
}

function contar() {
  const porProv = new Int32Array(COMARCAS.length * 2);
  let mio = 0, suyo = 0;
  for (let i = 0; i < cProv.length; i++) {
    const p = cProv[i]; if (p < 0) continue;
    if (cDue[i] === MIO) { mio++; porProv[p * 2]++; } else { suyo++; porProv[p * 2 + 1]++; }
  }
  let mias = 0, suyas = 0, partidas = 0;
  COMARCAS.forEach((c, k) => {
    const a = porProv[k * 2], b = porProv[k * 2 + 1];
    c.partida = a > 0 && b > 0 && Math.min(a, b) / (a + b) > 0.06;
    if (c.partida) partidas++;
    else if (a >= b) mias++; else suyas++;
  });
  cuenta = { mio, suyo, mias, suyas, partidas,
    bolsasM: bolsasDe(MIO), bolsasS: bolsasDe(SUYO) };
}
function panel() {
  document.getElementById("reloj").textContent = "día " + dia;
  const t = cuenta.mio + cuenta.suyo || 1;
  document.getElementById("bMio").style.cssText =
    `width:${(100 * cuenta.mio / t).toFixed(1)}%;background:var(--oro)`;
  document.getElementById("bSuyo").style.cssText =
    `width:${(100 * cuenta.suyo / t).toFixed(1)}%;background:var(--rojo)`;
  document.getElementById("tMio").textContent =
    `${Math.round(cuenta.mio * cfg.palmo * cfg.palmo).toLocaleString("es")} km² míos`;
  document.getElementById("tSuyo").textContent =
    `${Math.round(cuenta.suyo * cfg.palmo * cfg.palmo).toLocaleString("es")} km² suyos`;
  const km = (t) => Math.round(t * cfg.palmo * cfg.palmo).toLocaleString("es");
  const bolsa = (v, col) => v.length
    ? `<div style="color:${col}">◌ ${v.length} bolsa${v.length > 1 ? "s" : ""} `
      + `(${v.map(km).join(", ")} km²)</div>` : "";
  document.getElementById("comarcas").innerHTML =
    `⚑ ${cuenta.mias} mías · ✕ ${cuenta.suyas} suyas`
    + `<div>⚔ <b style="color:var(--tinta)">${cuenta.partidas} partidas al medio</b></div>`
    + bolsa(cuenta.bolsasS, "var(--oro)") + bolsa(cuenta.bolsasM, "var(--rojo)")
    + (cuenta.bolsasM.length + cuenta.bolsasS.length ? "" : "<div>sin bolsas</div>");
  document.getElementById("huestes").innerHTML = huestes.map((h, k) => `
    <div class="h" data-k="${k}" style="cursor:pointer;${k === elegida ? "color:var(--tinta)" : ""}">
      <span class="p" style="background:${h.bando === MIO ? "var(--oro)" : "var(--rojo)"}"></span>
      <span>${k === elegida ? "▸ " : ""}${h.nombre} · ${Math.round(h.n)} ud</span>
      <span style="margin-left:auto;color:var(--apagado)">${h.dest ? "en marcha" : "quieta"}</span>
    </div>`).join("");
  for (const el of document.querySelectorAll("#huestes .h"))
    el.onclick = () => { elegida = +el.dataset.k;
      document.getElementById("tropa").value = Math.round(huestes[elegida].n);
      document.getElementById("vTropa").textContent = Math.round(huestes[elegida].n); };
}

// ═══ el bucle ════════════════════════════════════════════════════
let resto = 0, antes = performance.now(), desdeCuenta = 0;
function cuadro(t) {
  const dt = Math.min(0.25, (t - antes) / 1000); antes = t;
  if (corriendo) {
    resto += dt * cfg.vel;
    let n = 0;
    while (resto >= 1 && n < 8) { unDia(); resto -= 1; n++; }
    if (resto > 8) resto = 8;
  }
  desdeCuenta += dt;
  if (desdeCuenta > 0.25) { contar(); desdeCuenta = 0; }
  if (siguiendo && huestes[elegida]) {
    const k = 1 - Math.pow(0.004, dt);
    mira.x += (huestes[elegida].x - mira.x) * k;
    mira.y += (huestes[elegida].y - mira.y) * k;
    encuadrar();
  }
  dibujar(); panel();
  requestAnimationFrame(cuadro);
}

// ═══ los mandos ══════════════════════════════════════════════════
cv.addEventListener("pointerdown", (e) => {
  const r = cv.getBoundingClientRect();
  const [mx, my] = aMundo(e.clientX - r.left, e.clientY - r.top);
  // ¿se tocó una hueste? entonces se elige, no se la manda a ningún lado
  for (let k = 0; k < huestes.length; k++)
    if (leguas(huestes[k], { x: mx, y: my }) < 18 / esc * GRADO_KM) { elegida = k; return; }
  const h = huestes[elegida]; if (!h) return;
  const k = celdaDe(mx, my);
  if (k < 0 || cProv[k] < 0) return;
  h.dest = { x: mx, y: my };
  document.getElementById("pista").textContent =
    `${h.nombre} marcha a ${COMARCAS[cProv[k]].n} · ${Math.round(leguas(h, h.dest))} km`;
});
const liga = (id, campo, muestra, tras) => {
  const el = document.getElementById(id);
  el.addEventListener("input", () => { cfg[campo] = +el.value;
    document.getElementById(muestra).textContent = el.value; if (tras) tras(); });
};
liga("vel", "vel", "vVel"); liga("ruido", "ruido", "vRuido");
liga("tropa", "tropa", "vTropa", () => { if (huestes[elegida]) huestes[elegida].n = cfg.tropa; });
{
  const el = document.getElementById("palmo");
  el.addEventListener("input", () => { cfg.palmo = +el.value;
    document.getElementById("vPalmo").textContent = el.value;
    // cambiar el tamaño del palmo es rehacer la rejilla: se empieza de nuevo
    reiniciar(); });
}
{
  const el = document.getElementById("lupa");
  el.addEventListener("input", () => { cfg.lupa = +el.value;
    document.getElementById("vLupa").textContent = (cfg.lupa / 10).toFixed(1); encuadrar(); });
}
const bCorrer = document.getElementById("correr");
bCorrer.onclick = () => { corriendo = !corriendo;
  bCorrer.textContent = corriendo ? "▶ correr" : "❚❚ quieto";
  bCorrer.classList.toggle("on", corriendo); };
document.getElementById("volver").onclick = () => { reiniciar(); contar(); };
const par = (a, b, alA, alB) => {
  const eA = document.getElementById(a), eB = document.getElementById(b);
  eA.onclick = () => { eA.classList.add("on"); eB.classList.remove("on"); alA(); };
  eB.onclick = () => { eB.classList.add("on"); eA.classList.remove("on"); alB(); };
};
par("mSigue", "mTodo", () => { siguiendo = true; encuadrar(); },
                       () => { siguiendo = false; encuadrar(); });
par("mDefiende", "mQuieto", () => { contra = true; },
                            () => { contra = false; for (const h of huestes) if (h.bando === SUYO) h.dest = null; });
document.getElementById("masMio").onclick = () => {
  const h = huestes[elegida] || huestes[0];
  huestes.push(nuevaHueste(MIO, h.x + 0.3, h.y + 0.3, cfg.tropa));
  elegida = huestes.length - 1;
};
document.getElementById("masSuyo").onclick = () => {
  const c = COMARCAS.filter((q) => q.p === "France")
    .map((q) => ({ q, d: leguas(huestes[elegida] || huestes[0], q) }))
    .sort((a, b) => a.d - b.d)[6];
  huestes.push(nuevaHueste(SUYO, c.q.x, c.q.y, Math.round(cfg.tropa * 0.8)));
};

for (const c of COMARCAS) c.pob = Math.round(60 + Math.hypot(c.x1 - c.x0, c.y1 - c.y0) / 2 * 900);
window.addEventListener("resize", encuadrar);
reiniciar(); contar();
requestAnimationFrame(cuadro);
</script>
</body>
</html>
